{
	"name": "denfrievilje.dk",
	"version": "0.0.1",
	"description": "Den Frie Vilje Website",
	"type": "module",
	"engines": {
		"node": "~25",
		"pnpm": "~10"
	},
	"scripts": {
		"images": "node scripts/process-images.js",
		"og": "node scripts/generate-og-images.js",
		"dev": "node scripts/process-images.js && node scripts/generate-og-images.js && vite",
		"prebuild": "node scripts/process-images.js && node scripts/generate-og-images.js",
		"build": "pnpm prebuild && pnpm build:artist && pnpm build:bureau",
		"build:artist": "BUILD_OUTPUT_DIR=build-artist PUBLIC_SITE_HOST=ole.kristensen.name PUBLIC_DOMAIN_MODE=artist vite build",
		"build:bureau": "BUILD_OUTPUT_DIR=build-bureau PUBLIC_SITE_HOST=denfrievilje.dk PUBLIC_DOMAIN_MODE=bureau vite build",
		"preview": "vite preview",
		"test:e2e": "vitest run --config vitest.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.53.2",
		"@sveltejs/mcp": "^0.1.20",
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"@tailwindcss/vite": "^4.2.1",
		"@types/p5": "^1.7.7",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.4.0",
		"js-yaml": "^4.1.1",
		"pdf-to-img": "^6.0.0",
		"prettier": "^3.0.0",
		"puppeteer": "^24.43.0",
		"sharp": "^0.34.5",
		"sirv": "^2.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^3.0.0",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.56.1",
		"vite": "^5.0.0",
		"vitest": "^1.4.7"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"@puppeteer/browsers",
			"puppeteer",
			"sharp",
			"svelte-preprocess"
		]
	},
	"dependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.3.3",
		"marked": "^17.0.3",
		"p5": "^2.3.0"
	}
}

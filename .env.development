# Dev-mode defaults for SvelteKit's $env/static/public so the imports in
# src/lib/site.ts and src/lib/components/Header.svelte resolve without
# requiring every contributor to set them manually. Production / staging
# builds get these from .github/workflows/deploy-*.yml via Docker --build-arg
# (see deploy/Dockerfile), so this file only affects `pnpm dev` and tests.
#
# These mirror the staging build's defaults so the local dev experience
# matches what's deployed at staging.denfrievilje.dk: bureau-first identity
# with the floating bureau/artist toggle exposed.
#
# Local overrides (e.g. testing the artist-side build) go in
# `.env.development.local`, which is gitignored.

PUBLIC_SITE_HOST=denfrievilje.dk
PUBLIC_DOMAIN_MODE=bureau
PUBLIC_SHOW_PALETTE_TOGGLE=true

# Dev builds bake the Disallow-all robots.txt, same as staging. Only
# .env.production sets this to 'true' (see src/routes/robots.txt/+server.ts).
PUBLIC_ALLOW_INDEXING=false

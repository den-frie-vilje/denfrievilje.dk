# Public build-time env for production builds: the default mode (a plain
# `pnpm build`) and deploy/Dockerfile with VITE_MODE=production, as passed
# by .github/workflows/deploy-production.yml. PUBLIC_* values only, never
# secrets: everything here is baked into public output.
#
# Identity env (PUBLIC_SITE_HOST, PUBLIC_DOMAIN_MODE) is deliberately NOT
# set here: the per-identity build scripts set it inline per tree, and
# process env wins over mode files, so mode and identity stay orthogonal.

# Only the literal 'true' bakes the indexable robots.txt (Allow plus the
# per-identity sitemap advert); the route is fail-closed for any other
# value (src/routes/robots.txt/+server.ts).
PUBLIC_ALLOW_INDEXING=true

# Production hides the floating bureau/artist palette toggle; palettes are
# hostname-driven only. Same value as the deploy-production workflow's
# build-arg; the build-arg (process env) wins over this mode-file default,
# so this line is what makes a plain local `pnpm build` work without
# exporting anything.
PUBLIC_SHOW_PALETTE_TOGGLE=false

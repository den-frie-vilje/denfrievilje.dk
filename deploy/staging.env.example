# Stack-level env file for staging. Copy to:
#   /volume1/docker/denfrievilje.dk/staging/staging.env
# on the NAS (root:docker 0640) — see nas-sites bootstrap-site.sh.
#
# Variables here are consumed by compose.staging.yml's `${VAR}`
# interpolations only. CF tokens for cache purge live in the per-(site,env)
# config under /volume1/docker/nas-sites/sites.d/, not here.

# Loopback port DSM Web Station's staging vhost reverse-proxies into.
# Allocation convention: skovby uses 18080/18081, denfrievilje takes 18082/18083.
# Verify the chosen port is unoccupied with:
#   sudo netstat -tln | grep ':18082'
CADDY_PORT=18082

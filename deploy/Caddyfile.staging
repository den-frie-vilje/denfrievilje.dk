# Front-door reverse proxy for staging (denfrievilje-dk.stage.denfrievilje.dk).
#
# DSM Web Station proxies the staging hostname to 127.0.0.1:${CADDY_PORT}
# on this host. Caddy listens on :80 inside the container, reverse-proxies
# to the site container on :8080.
#
# Identity selection is header-based: requests without an X-Site-Mode header
# get the bureau tree (matches production default at denfrievilje.dk).
# To preview the artist tree on staging, send an X-Site-Mode: artist header
# from the client (curl, browser dev tools, or a DSM Web Station vhost rule
# that injects the header for an artist staging hostname). Caddy passes the
# header through to nginx untouched.

{
    admin off
    auto_https off
}

:80 {
    reverse_proxy site:8080
    encode gzip zstd

    log {
        output stdout
        format json
    }
}

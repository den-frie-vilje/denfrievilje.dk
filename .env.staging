# Public build-time env baked into staging images. deploy/Dockerfile runs
# `pnpm build` with VITE_MODE=staging (passed as a build-arg by
# .github/workflows/deploy-staging.yml), and the build scripts hand it to
# Vite as `--mode staging`, which loads this file. PUBLIC_* values only,
# never secrets: everything here is baked into public output.
#
# Identity env (PUBLIC_SITE_HOST, PUBLIC_DOMAIN_MODE) is deliberately NOT
# set here: the per-identity build scripts set it inline per tree, and
# process env wins over mode files, so mode and identity stay orthogonal.

# Staging must never enter a search index: with this false, the robots.txt
# route (src/routes/robots.txt/+server.ts) bakes Disallow-all with no
# sitemap advert. That baked file is the primary strap; the X-Robots-Tag
# header in deploy/Caddyfile.staging is the backstop.
PUBLIC_ALLOW_INDEXING=false

# Staging exposes the floating bureau/artist palette toggle. Same value as
# the deploy-staging workflow's build-arg; the build-arg (process env) wins
# over this mode-file default, so this line is what makes local
# `VITE_MODE=staging pnpm build` work without exporting anything.
PUBLIC_SHOW_PALETTE_TOGGLE=true
